# Supabase 프로젝트 설정 (https://supabase.com → 프로젝트 → Settings → API)
# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. 비워두면 로그인 없는 게스트 모드로 동작합니다.
# ANON_KEY 자리에는 신규 키 체계의 publishable 키(sb_publishable_...)를 넣으면 됩니다 (legacy anon 키도 호환).
# 주의: secret 키(sb_secret_...)는 서버 전용 — 절대 여기(VITE_)에 넣지 마세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 관리자 이메일 (쉼표로 구분). 프로젝트 삭제 등 관리자 전용 기능을 쓸 수 있는 계정을 지정합니다.
# 게스트 모드(로그인 미설정)에서는 전원 관리자로 동작합니다. 예: joshua@276holdings.com

# ────────────────────────────────────────────────────────────────────────────
# 서버 전용 시크릿 (서버리스 함수 환경변수로만 설정 — VITE_ 접두사 금지!)
#   VITE_ 접두사가 붙으면 클라이언트 번들에 그대로 노출되므로 절대 사용하지 말 것.
#   아래 값들은 로컬 .env가 아니라 배포 플랫폼(예: Vercel/Netlify)의 함수
#   환경변수 또는 Supabase Edge Function 시크릿으로 주입한다.
# ────────────────────────────────────────────────────────────────────────────
# Gemini AI (요약·문맥 다듬기 등) — 서버 함수에서만 호출
# GEMINI_API_KEY=
# 구글 드라이브 접근용 서비스 계정 JSON (한 줄 문자열) 또는 OAuth 리프레시 토큰 중 택1
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# 업로드 파일을 담을 관리자 드라이브 폴더 ID
# DRIVE_APP_FOLDER_ID=

# 개인 구글 드라이브 첨부(Apps Script 웹앱) — 서버 전용. VITE_ 접두사 금지
DRIVE_WEBAPP_URL=
DRIVE_WEBAPP_TOKEN=

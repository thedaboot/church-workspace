{
  "rewrites": [
    {
      "source": "/s/:type/:id",
      "destination": "/api/share?type=:type&id=:id"
    }
  ],
  "crons": [
    {
      "path": "/api/push",
      "schedule": "0 22 * * *"
    }
  ],
  "functions": {
    "api/drive.js": {
      "maxDuration": 60
    },
    "api/drive-file.js": {
      "maxDuration": 30
    },
    "api/ai.js": {
      "maxDuration": 30
    },
    "api/yt.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/chars/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/bible/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}

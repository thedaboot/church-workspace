{
  "regions": ["icn1"],
  "rewrites": [
    {
      "source": "/s/:type/:id",
      "destination": "/api/share?type=:type&id=:id"
    }
  ],
  "crons": [
    {
      "path": "/api/push",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/push?job=worship",
      "schedule": "30 2 * * *"
    }
  ],
  "functions": {
    "api/drive.js": {
      "maxDuration": 60
    },
    "api/drive-file.js": {
      "maxDuration": 30
    },
    "api/ai.js": {
      "maxDuration": 30
    },
    "api/yt.js": {
      "maxDuration": 15
    },
    "api/push.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-miZAjKEkwHl4U05wtId7j49hGeM7wy5mufo9ezy+knQ=' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co https://lh3.googleusercontent.com https://*.googleusercontent.com https://*.kakaocdn.net http://*.kakaocdn.net https://i.ytimg.com https://drive.google.com https://docs.google.com; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src 'self' blob: https://docs.google.com https://drive.google.com https://www.youtube.com https://www.youtube-nocookie.com https://view.officeapps.live.com; media-src 'self' blob: https://*.supabase.co https://drive.google.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/chars/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/bible/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/pdfjs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
